{
  "name": "cidey-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
  "dev": "next dev",
  "build": "next build",
  "pages:build": "npx vercel build --yes --env npm_config_legacy_peer_deps=true && npx @cloudflare/next-on-pages --skip-build",
  "deploy": "npm run pages:build && npx wrangler pages deploy .vercel/output/static --project-name=cidey",
  "start": "next start",
  "lint": "eslint"
},
  "dependencies": {
    "@upstash/redis": "^1.38.1",
    "nanoid": "^6.0.0",
    "next": "^16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.7",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "wrangler": "^4.131.1"
  }
}